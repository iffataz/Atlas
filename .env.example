MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
GROQ_API_KEY=gsk_your_api_key_here
# Optional: durable rate limiting across serverless instances (Upstash Redis).
# Without these, limits are kept in memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
